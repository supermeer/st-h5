# Mock 环境配置（仅在本地生效）
# 复制本文件为 .env.development 并修改 VITE_USE_MOCK=true 即可启用本地 Mock 模式
# 启用后所有 API 请求将返回 src/api/config.js 中 mockHandlers 里定义的本地测试数据
# 适用于：
#   1. 后端服务暂不可用时调试前端
#   2. 离线查看 UI 效果
#   3. 提交 PR 前的本地回归

# 后端 API 基础地址（在 Mock 模式下不会真正请求）
VITE_API_BASE_URL=http://localhost:19000

# 是否启用 mock 数据
VITE_USE_MOCK=true

# 应用标题
VITE_APP_TITLE=星语酒馆
